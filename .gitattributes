# Default: let git pick text vs binary; honour core.autocrlf for source.
* text=auto

# Husky hooks MUST be LF — they're sh scripts run by git, and CRLF makes
# `sh` exit with "Exec format error" on Windows checkouts with
# core.autocrlf=true. Without this rule, switching branches on a
# Windows machine corrupts the hooks and blocks every commit.
.husky/* text eol=lf

# Shell + helper scripts: same reasoning.
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Generated files Prettier shouldn't touch — also keep them LF so the
# openapi-typescript regen diff stays clean across platforms.
src/lib/api-types.ts text eol=lf

# server/.env.example is generated by `npm run config:sync` (which emits LF) and
# verified by the pre-push `config:check`. Without an LF pin, core.autocrlf=true
# checks it out as CRLF on Windows, so `config:check` fails for every Windows dev
# on a clean tree (the generator emits LF, the checkout is CRLF). Pin to LF.
.env.example text eol=lf

# openapi.yaml is read as text at runtime by the parity test and is the input to
# `npm run openapi:types`. With core.autocrlf=true on Windows, it materialises as
# CRLF and breaks line-anchored matching in schemaBlock() (#1952). Pin to LF.
openapi.yaml text eol=lf

# server/tts-sidecar/requirements/*.txt feed resolveRequired()'s reqHash
# (server/tts-sidecar/scripts/venv-migration.mjs), which is hashed from raw file
# bytes (no normalization) and persisted to the venv stamp, then compared across
# checkouts/machines (a Windows dev box vs. the ubuntu-latest release build). With
# core.autocrlf=true on Windows, these files materialise as CRLF and hash
# differently from an LF checkout of the identical content, causing a spurious
# 'pip-in-place' migration (#2586). Pin to LF.
server/tts-sidecar/requirements/*.txt text eol=lf

# Binary files we never want autocrlf to touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.m4b binary
*.pdf binary
*.zip binary
*.epub binary
*.pt binary
*.opus binary
*.mobi binary
