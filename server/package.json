{
  "name": "castwright-server",
  "version": "1.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include=.env src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "node ../scripts/preflight-ffmpeg.cjs",
    "audit": "node ../scripts/check-audit.mjs --omit-dev",
    "test": "vitest run",
    "pretest:changed": "node ../scripts/preflight-ffmpeg.cjs",
    "test:changed": "vitest run --changed HEAD",
    "test:slow": "vitest run --config vitest.config.slow.ts",
    "test:golden": "vitest run --config vitest.config.golden.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@types/yazl": "^3.3.1",
    "cookie": "^2.0.1",
    "entities": "^8.0.0",
    "epub2": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "franc": "^6.2.0",
    "multer": "^2.3.0",
    "nanoid": "^6.0.1",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.4",
    "undici": "^8.10.1",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "adm-zip": ">=0.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/picomatch": "^4.0.3",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.3.0",
    "picomatch": "^4.0.7",
    "std-env": "^4.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
